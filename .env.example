# NSTU Merch - Environment Configuration

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="NSTU MERCH"

# Supabase (Optional: automatically switches to Supabase PostgreSQL when credentials are provided)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Initial Admin Credentials (Used to access /admin out of the box)
ADMIN_DEFAULT_EMAIL=admin@nstu.edu.bd
ADMIN_DEFAULT_PASSWORD=nstuadmin123

# Secret for session tokens / cookies
JWT_SECRET=nstu_merch_secret_key_university_pride_2026
